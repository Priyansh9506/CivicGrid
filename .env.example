# Copy this file to .env and change the values to match your MySQL server.
# .env is git-ignored, so your password is never committed.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=civicgrid

# Port the CivicGrid server listens on (http://localhost:3000)
PORT=3000

# MongoDB Configuration (Practical 10)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=civicgrid_mongo
